{
  "name": "occupancy-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Agent performance & occupancy calculator for RGM (Dispatch Operations). Combines a daily roster with 30-min interval metrics from Amazon Connect. Built with TypeScript/React.",
  "type": "module",
  "license": "MIT",
  "author": "Nalin Heinrich <nalinheinrich@gmail.com> (https://github.com/nalinheinrich)",
  "repository": {
    "type": "git",
    "url": "https://github.com/nalinheinrich/occupancy-calculator.git"
  },
  "homepage": "https://github.com/nalinheinrich/occupancy-calculator#readme",
  "bugs": {
    "url": "https://github.com/nalinheinrich/occupancy-calculator/issues"
  },
  "keywords": [
    "typescript",
    "react",
    "occupancy",
    "call-center",
    "workforce-management",
    "analytics",
    "amazon-connect",
    "performance-tracker",
    "aht",
    "dispatch-operations",
    "quicksight"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "occupancy": "tsx scripts/calculate-occupancy.ts",
    "scorecard": "tsx scripts/generate-scorecard.ts",
    "merge": "tsx scripts/merge-roster-metrics.ts",
    "generate-data": "tsx scripts/generate-synthetic-data.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vite": "5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
