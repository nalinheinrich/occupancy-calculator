{
  // Node.js code: the CLI scripts in this folder and the root vite.config.ts.
  // Named tsconfig.json so editors pick it up automatically for files in scripts/.
  // The scripts import the shared calculation code in webapp/src/utils, which is
  // type-checked here as well.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../vite.config.ts"]
}
