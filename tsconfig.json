{
  // Browser app (webapp/src). No Node.js types here, so Node-only APIs such as
  // process or Buffer are flagged instead of crashing at runtime in the browser.
  // Vite's client types come from webapp/src/vite-env.d.ts.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["webapp/src"]
}
